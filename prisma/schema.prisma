generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContentType {
  VIDEO
  TEXT
  FILE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ============================================
// ENTIDADES PRINCIPAIS
// ============================================

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  asaasCustomerId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  progress    StudentProgress[]
  purchases   StudentPurchase[]
  certificates Certificate[]

  @@map("users")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Campos de marketing (M12a)
  coverImageUrl      String? // capa do card na vitrine
  category           String? // Ex.: "Marketing Digital", "Programação"
  shortDescription   String? // descrição curta para o card da vitrine
  learningObjectives String? // texto longo (markdown/parágrafos)
  targetAudience     String? // para quem é
  prerequisites      String? // conhecimentos necessários
  skills             String? // habilidades (separadas por vírgula)
  hasCertificate     Boolean  @default(true)

  // Preço do pacote completo (todos os módulos) em centavos. null = pacote indisponível (M12c)
  bundlePriceCents Int?

  modules      Module[]
  certificates Certificate[]

  @@map("courses")
}

model Module {
  id                   String   @id @default(cuid())
  courseId             String
  title                String
  description          String?
  orderIndex           Int      // ordem linear: 1, 2, 3...
  priceCents           Int      // preço em centavos (evita float)
  presentationVideoUrl String? // vídeo de vitrine do próximo módulo
  estimatedDurationMinutes Int? // duração estimada em minutos
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons    Lesson[]
  purchases  StudentPurchase[]

  @@unique([courseId, orderIndex])
  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id           String      @id @default(cuid())
  moduleId     String
  title        String
  contentType  ContentType
  videoUrl     String?
  textContent  String?     // usado quando contentType = TEXT
  fileUrl      String?     // usado quando contentType = FILE
  orderIndex   Int         // ordem da aula dentro do módulo
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  module   Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress StudentProgress[]

  @@unique([moduleId, orderIndex])
  @@index([moduleId])
  @@map("lessons")
}

model StudentProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("student_progress")
}

model StudentPurchase {
  id             String        @id @default(cuid())
  userId         String
  moduleId       String
  statusPayment  PaymentStatus @default(PENDING)
  paymentToken   String?       // token do gateway (para one-click buy futuro)
  externalId     String?       // id da transação no gateway
  invoiceUrl     String?
  paymentMethod  String?       // 'PIX' | 'BOLETO' | 'CREDIT_CARD'
  purchasedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@map("student_purchases")
}

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  code       String   @unique // código público de validação
  issuedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("certificates")
}
