# ============================================
# dumo — Variáveis de PRODUÇÃO (Vercel)
# ============================================
# Copie este arquivo como referência ao configurar
# as envs no painel da Vercel (Settings → Environment Variables).

# Banco (Neon produção — pooled)
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth
AUTH_SECRET="gere-com-openssl-rand-base64-32"
AUTH_URL="https://SEU-DOMINIO.vercel.app"
NEXTAUTH_URL="https://SEU-DOMINIO.vercel.app"

# App (usado em metadataBase para OG tags)
NEXT_PUBLIC_APP_URL="https://SEU-DOMINIO.vercel.app"

# Asaas (sandbox nesta primeira fase — troque depois para produção)
ASAAS_API_KEY="aact_hmlg_..."
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN="gere-com-openssl-rand-hex-24"

# Seed de produção (usado apenas uma vez, ao rodar db:seed:prod)
ADMIN_EMAIL="seu-email@exemplo.com"
ADMIN_PASSWORD="senha-forte-com-12-caracteres"
ADMIN_NAME="Seu Nome"
