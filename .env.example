DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Pagamentos (Módulo 6)
PAYMENT_PROVIDER=""
PAYMENT_API_KEY=""

# Asaas (M6)
# IMPORTANTE: o Asaas usa chaves que começam com "$" (ex.: $aact_hmlg_...).
# O Next.js expande "$" no .env, o que pode zerar a variável.
#
# FORMATO RECOMENDADO (imune ao problema):
#   Cole a chave SEM o "$" inicial. O código adiciona automaticamente.
#   Ex.: ASAAS_API_KEY="aact_hmlg_abc123..."
#
# Formatos também aceitos (mas mais frágeis):
#   ASAAS_API_KEY="\$aact_hmlg_abc123..."   (com escape)
#   ASAAS_API_KEY="$aact_hmlg_abc123..."    (sem escape — pode falhar)
ASAAS_API_KEY=""
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"

# Webhook Asaas (M6c)
# Token de validacao dos webhooks (Integracoes -> Webhooks no painel Asaas).
# Gere um aleatorio: openssl rand -hex 24
ASAAS_WEBHOOK_TOKEN=""
